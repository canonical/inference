#!/bin/sh
set -eu

host="$(snapctl get http.host)"
port="$(snapctl get http.port)"

if [ -z "$host" ]; then
    echo "http.host must not be empty" >&2
    exit 1
fi

case "$port" in
    ''|*[!0-9]*|0|0*|??????*)
        echo "http.port must be an integer between 1 and 65535" >&2
        exit 1
        ;;
esac

if [ "$port" -gt 65535 ]; then
    echo "http.port must be an integer between 1 and 65535" >&2
    exit 1
fi

cors_allow_all="$(snapctl get http.cors-allow-all)"
case "$cors_allow_all" in
    ''|true|false) ;;
    *)
        echo "http.cors-allow-all must be true or false" >&2
        exit 1
        ;;
esac

snapctl restart "$SNAP_INSTANCE_NAME"
